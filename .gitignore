# Dependencies
node_modules/

# Build output (1.4 GB of packaged installers — never commit)
release/
dist/
out/

# Bundled third-party binaries. These are large (~225 MB together), are not
# ours to redistribute, and belong in a release artifact rather than in git
# history. See the README for where to get each one.
resources/aria2/
resources/7zip/
resources/easytier/
resources/updater/
resources/goldberg/
resources/yt-dlp/

# Local runtime state and anything with credentials in it
discord-rpc.json
*.local.json
.env
.env.*

# Caches this app writes next to itself
games-list-*.json
page-covers.json
sudata.json
sudata.json.bak

# Logs / crash dumps
*.log
crash_logs/
logs/

# OS / editor noise
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
