{
  "name": "ninogames",
  "version": "1.1.6",
  "description": "NinoGames — Free PC Game Downloader",
  "author": "nino",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.nino.ninogames",
    "productName": "NinoGames",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "party.js",
      "store.js",
      "tracker.js",
      "renderer/**/*",
      "multiplayermod.json",
      "resources/icon.ico",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "resources/7zip",
        "to": "7zip"
      },
      {
        "from": "resources/aria2",
        "to": "aria2"
      },
      {
        "from": "resources/easytier",
        "to": "easytier"
      },
      {
        "from": "resources/goldberg",
        "to": "goldberg"
      },
      {
        "from": "resources/updater",
        "to": "updater"
      },
      {
        "from": "resources/yt-dlp",
        "to": "yt-dlp"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "portable": {
      "artifactName": "NinoGames-${version}-portable.exe"
    }
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "steam-shortcut-editor": "^3.1.3"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
